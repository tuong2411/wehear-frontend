"12\" cy=\"13\" r=\"3\"></circle></svg> Dịch trực tiếp</button><button class=\"flex-1 flex items-center justify-center gap-3 py-4 rounded-[20px] text-sm font-black transition-all text-slate-500 hover:text-slate-700\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-languages\" aria-hidden=\"true\"><path d=\"m5 8 6 6\"></path><path d=\"m4 14 6-6 2-3\"></path><path d=\"M2 5h12\"></path><path d=\"M7 2h1\"></path><path d=\"m22 22-5-10-5 10\"></path><path d=\"M14 18h6\"></path></svg> Văn bản → Ký hiệu</button><button class=\"flex-1 flex items-center justify-center gap-3 py-4 rounded-[20px] text-sm font-black transition-all text-slate-500 hover:text-slate-700\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-video\" aria-hidden=\"true\"><path d=\"m16 13 5.223 3.482a.5.5 0 0 0 .777-.416V7.87a.5.5 0 0 0-.752-.432L16 10.5\"></path><rect x=\"2\" y=\"6\" width=\"14\" height=\"12\" rx=\"2\"></rect></svg> Tải video</button></div></div></div></div><div class=\"max-w-7xl mx-auto px-6 py-16\"><div class=\"grid grid-cols-1 gap-12\"><div class=\"max-w-7xl mx-auto space-y-8\"><div class=\"grid grid-cols-1 lg:grid-cols-12 gap-8\"><div class=\"lg:col-span-8 space-y-6\"><div class=\"relative bg-slate-900 rounded-[48px] overflow-hidden aspect-video shadow-2xl ring-8 ring-white group\"><video autoPlay=\"\" playsInline=\"\" muted=\"\" class=\"w-full h-full object-cover scale-x-[-1] hidden\"></video><div class=\"w-full h-full flex flex-col items-center justify-center text-slate-500 gap-6\"><div class=\"w-24 h-24 rounded-full bg-slate-800 flex items-center justify-center animate-pulse\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"40\" height=\"40\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-camera text-slate-600\" aria-hidden=\"true\"><path d=\"M13.997 4a2 2 0 0 1 1.76 1.05l.486.9A2 2 0 0 0 18.003 7H20a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V9a2 2 0 0 1 2-2h1.997a2 2 0 0 0 1.759-1.048l.489-.904A2 2 0 0 1 10.004 4z\"></path><circle cx=\"12\" cy=\"13\" r=\"3\"></circle></svg></div><div class=\"text-center\"><p class=\"text-xl font-black text-slate-400\">Camera đang tắt</p><p class=\"text-sm font-bold text-slate-600 mt-2\">Nhấn &quot;Bắt đầu dịch&quot; để kích hoạt AI</p></div></div><div class=\"absolute top-8 left-8 flex items-center gap-3\"><div class=\"flex items-center gap-2 px-4 py-2 rounded-full backdrop-blur-md border bg-white/10 border-white/10 text-white/50\"><div class=\"w-2 h-2 rounded-full bg-slate-500\"></div><span class=\"text-[10px] font-black uppercase tracking-widest\">Offline</span></div></div><div class=\"absolute bottom-8 right-8 flex items-center gap-3 opacity-0 group-hover:opacity-100 transition-opacity\"><button class=\"p-4 rounded-3xl transition-all bg-white text-slate-900\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-volume2 lucide-volume-2\" aria-hidden=\"true\"><path d=\"M11 4.702a.705.705 0 0 0-1.203-.498L6.413 7.587A1.4 1.4 0 0 1 5.416 8H3a1 1 0 0 0-1 1v6a1 1 0 0 0 1 1h2.416a1.4 1.4 0 0 1 .997.413l3.383 3.384A.705.705 0 0 0 11 19.298z\"></path><path d=\"M16 9a5 5 0 0 1 0 6\"></path><path d=\"M19.364 18.364a9 9 0 0 0 0-12.728\"></path></svg></button><button class=\"p-4 bg-white/20 backdrop-blur-md text-white rounded-3xl hover:bg-white/30 transition-all\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-settings\" aria-hidden=\"true\"><path d=\"M9.671 4.136a2.34 2.34 0 0 1 4.659 0 2.34 2.34 0 0 0 3.319 1.915 2.34 2.34 0 0 1 2.33 4.033 2.34 2.34 0 0 0 0 3.831 2.34 2.34 0 0 1-2.33 4.033 2.34 2.34 0 0 0-3.319 1.915 2.34 2.34 0 0 1-4.659 0 2.34 2.34 0 0 0-3.32-1.915 2.34 2.34 0 0 1-2.33-4.033 2.34 2.34 0 0 0 0-3.831A2.34 2.34 0 0 1 6.35 6.051a2.34 2.34 0 0 0 3.319-1.915\"></path><circle cx=\"12\" cy=\"12\" r=\"3\"></circle></svg></button></div></div><div class=\"flex items-center justify-between px-4\"><div class=\"flex items-center gap-6\"><button class=\"flex items-center gap-3 px-10 py-5 rounded-[32px] font-black text-lg transition-all shadow-2xl bg-slate-900 text-white shadow-slate-200 hover:bg-blue-600\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-play\" aria-hidden=\"true\"><path d=\"M5 5a2 2 0 0 1 3.008-1.728l11.997 6.998a2 2 0 0 1 .003 3.458l-12 7A2 2 0 0 1 5 19z\"></path></svg> Bắt đầu dịch</button><div class=\"flex items-center gap-3 text-slate-400\"><div class=\"w-12 h-12 rounded-2xl bg-white border border-slate-100 flex items-center justify-center\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-mic\" aria-hidden=\"true\"><path d=\"M12 19v3\"></path><path d=\"M19 10v2a7 7 0 0 1-14 0v-2\"></path><rect x=\"9\" y=\"2\" width=\"6\" height=\"13\" rx=\"3\"></rect></svg></div><div><p class=\"text-[10px] font-black uppercase tracking-widest text-slate-400\">Âm thanh đầu ra</p><p class=\"text-sm font-bold text-slate-700\">Tự động phát âm thanh</p></div></div></div><button class=\"flex items-center gap-2 text-slate-400 font-bold hover:text-rose-500 transition-colors\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-trash2 lucide-trash-2\" aria-hidden=\"true\"><path d=\"M10 11v6\"></path><path d=\"M14 11v6\"></path><path d=\"M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6\"></path><path d=\"M3 6h18\"></path><path d=\"M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2\"></path></svg> Xóa lịch sử</button></div></div><div class=\"lg:col-span-4 h-full\"><div class=\"bg-white rounded-[48px] border border-slate-100 shadow-xl shadow-slate-200/50 p-8 flex flex-col h-[600px]\"><div class=\"flex items-center justify-between mb-8\"><h3 class=\"text-xl font-black text-slate-900 flex items-center gap-3\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-message-square text-rose-500\" aria-hidden=\"true\"><path d=\"M22 17a2 2 0 0 1-2 2H6.828a2 2 0 0 0-1.414.586l-2.202 2.202A.71.71 0 0 1 2 21.286V5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2z\"></path></svg> Nhật ký hội thoại</h3><span class=\"bg-rose-50 text-rose-600 px-3 py-1 rounded-full text-[10px] font-black\">LIVE</span></div><div class=\"flex-1 overflow-y-auto space-y-4 pr-2 custom-scrollbar flex flex-col-reverse\"><div class=\"flex-1 flex flex-col items-center justify-center text-center p-10 space-y-4 opacity-30\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"48\" height=\"48\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-ellipsis text-slate-400\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"1\"></circle><circle cx=\"19\" cy=\"12\" r=\"1\"></circle><circle cx=\"5\" cy=\"12\" r=\"1\"></circle></svg><p class=\"text-sm font-bold text-slate-400\">Hội thoại sẽ được ghi lại tại đây theo thời gian thực</p></div></div><div class=\"mt-8 pt-8 border-t border-slate-50\"><div class=\"flex items-center gap-4 p-4 bg-blue-50 rounded-3xl border border-blue-100\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-brain-circuit text-blue-500 flex-shrink-0\" aria-hidden=\"true\"><path d=\"M12 5a3 3 0 1 0-5.997.125 4 4 0 0 0-2.526 5.77 4 4 0 0 0 .556 6.588A4 4 0 1 0 12 18Z\"></path><path d=\"M9 13a4.5 4.5 0 0 0 3-4\"></path><path d=\"M6.003 5.125A3 3 0 0 0 6.401 6.5\"></path><path d=\"M3.477 10.896a4 4 0 0 1 .585-.396\"></path><path d=\"M6 18a4 4 0 0 1-1.967-.516\"></path><path d=\"M12 13h4\"></path><path d=\"M12 18h6a2 2 0 0 1 2 2v1\"></path><path d=\"M12 8h8\"></path><path d=\"M16 8V5a2 2 0 0 1 2-2\"></path><circle cx=\"16\" cy=\"13\" r=\".5\"></circle><circle cx=\"18\" cy=\"3\" r=\".5\"></circle><circle cx=\"20\" cy=\"21\" r=\".5\"></circle><circle cx=\"20\" cy=\"8\" r=\".5\"></circle></svg><p class=\"text-[11px] text-blue-700 font-bold leading-relaxed\">Hệ thống đang sử dụng Model nhận diện ngôn ngữ ký hiệu tự nhiên (Natural Sign Language).</p></div></div></div></div></div></div></div><div class=\"mt-32 grid grid-cols-1 md:grid-cols-3 gap-8\"><div class=\"bg-white p-8 rounded-[40px] border border-slate-100 shadow-sm space-y-4\"><div class=\"w-14 h-14 bg-emerald-50 text-emerald-500 rounded-2xl flex items-center justify-center\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"28\" height=\"28\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-shield-check\" aria-hidden=\"true\"><path d=\"M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z\"></path><path d=\"m9 12 2 2 4-4\"></path></svg></div><h4 class=\"text-xl font-black text-slate-900\">Độ chính xác cao</h4><p class=\"text-slate-500 text-sm font-medium leading-relaxed\">Dữ liệu được kiểm duyệt bởi các chuyên gia ngôn ngữ ký hiệu Việt Nam (VSL).</p></div><div class=\"bg-white p-8 rounded-[40px] border border-slate-100 shadow-sm space-y-4\"><div class=\"w-14 h-14 bg-blue-50 text-blue-500 rounded-2xl flex items-center justify-center\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"28\" height=\"28\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-languages\" aria-hidden=\"true\"><path d=\"m5 8 6 6\"></path><path d=\"m4 14 6-6 2-3\"></path><path d=\"M2 5h12\"></path><path d=\"M7 2h1\"></path><path d=\"m22 22-5-10-5 10\"></path><path d=\"M14 18h6\"></path></svg></div><h4 class=\"text-xl font-black text-slate-900\">Đa ngôn ngữ</h4><p class=\"text-slate-500 text-sm font-medium leading-relaxed\">Hỗ trợ dịch từ tiếng Việt sang ký hiệu và nhận diện ký hiệu qua video.</p></div><div class=\"bg-white p-8 rounded-[40px] border border-slate-100 shadow-sm space-y-4\"><div class=\"w-14 h-14 bg-purple-50 text-purple-500 rounded-2xl flex items-center justify-center\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"28\" height=\"28\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-message-square\" aria-hidden=\"true\"><path d=\"M22 17a2 2 0 0 1-2 2H6.828a2 2 0 0 0-1.414.586l-2.202 2.202A.71.71 0 0 1 2 21.286V5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2z\"></path></svg></div><h4 class=\"text-xl font-black text-slate-900\">Hỗ trợ cộng đồng</h4><p class=\"text-slate-500 text-sm font-medium leading-relaxed\">Giúp người khiếm thính và người nghe hiểu nhau hơn trong cuộc sống.</p></div></div><div class=\"mt-16 bg-slate-900 rounded-[48px] p-8 md:p-16 text-white overflow-hidden relative\"><div class=\"absolute top-0 right-0 w-1/3 h-full bg-gradient-to-l from-blue-600/20 to-transparent\"></div><div class=\"relative z-10 flex flex-col md:flex-row items-center justify-between gap-12\"><div class=\"max-w-xl space-y-6\"><h3 class=\"text-3xl font-black leading-tight\">Hướng dẫn sử dụng hệ thống phiên dịch</h3><div class=\"space-y-4\"><div class=\"flex items-start gap-4\"><div class=\"w-8 h-8 rounded-full bg-blue-600 flex items-center justify-center text-sm font-black flex-shrink-0\">1</div><p class=\"text-slate-300 font-medium\">Nhập câu văn hoặc cụm từ tiếng Việt bạn muốn truyền đạt vào khung dịch nhanh.</p></div><div class=\"flex items-start gap-4\"><div class=\"w-8 h-8 rounded-full bg-blue-600 flex items-center justify-center text-sm font-black flex-shrink-0\">2</div><p class=\"text-slate-300 font-medium\">Hệ thống sẽ phân tích và tìm kiếm các video ký hiệu tương ứng trong từ điển của chúng tôi.</p></div><div class=\"flex items-start gap-4\"><div class=\"w-8 h-8 rounded-full bg-blue-600 flex items-center justify-center text-sm font-black flex-shrink-0\">3</div><p class=\"text-slate-300 font-medium\">Nếu từ không có trong từ điển, hệ thống sẽ tự động thực hiện đánh vần bằng ký hiệu chữ cái.</p></div></div></div><div class=\"flex-shrink-0 bg-white/10 backdrop-blur-md p-8 rounded-[40px] border border-white/10\"><div class=\"flex items-center gap-3 mb-6\"><div class=\"w-3 h-3 bg-rose-500 rounded-full\"></div><div class=\"w-3 h-3 bg-amber-500 rounded-full\"></div><div class=\"w-3 h-3 bg-emerald-500 rounded-full\"></div></div><div class=\"space-y-4\"><div class=\"h-4 w-48 bg-white/20 rounded-full\"></div><div class=\"h-4 w-32 bg-white/10 rounded-full\"></div><div class=\"h-4 w-40 bg-white/15 rounded-full\"></div></div></div></div></div></div></main></main><footer class=\"border-t border-slate-200 bg-white\"><div class=\"mx-auto grid max-w-7xl gap-10 px-6 py-12 md:grid-cols-3\"><div><h3 class=\"text-xl font-bold text-slate-900\">WeHear</h3><p class=\"mt-3 text-sm leading-6 text-slate-600\">Nền tảng hỗ trợ nhận diện và dịch ngôn ngữ ký hiệu tiếng Việt sang văn bản, giúp tăng khả năng giao tiếp và tiếp cận thông tin cho cộng đồng người khiếm thính.</p></div><div><h4 class=\"text-sm font-semibold uppercase tracking-wide text-slate-900\">Điều hướng</h4><ul class=\"mt-4 space-y-3 text-sm text-slate-600\"><li><a class=\"hover:text-blue-600\" href=\"/\">Trang chủ</a></li><li><a class=\"hover:text-blue-600\" href=\"/translate\">Dịch ký hiệu</a></li><li><a class=\"hover:text-blue-600\" href=\"/dictionary\">Từ điển</a></li><li><a class=\"hover:text-blue-600\" href=\"/news\">Tin tức</a></li></ul></div><div><h4 class=\"text-sm font-semibold uppercase tracking-wide text-slate-900\">Thông tin dự án</h4><ul class=\"mt-4 space-y-3 text-sm text-slate-600\"><li>Khóa luận tốt nghiệp</li><li>AI + Web Application</li><li>Ngôn ngữ ký hiệu tiếng Việt</li></ul></div></div><div class=\"border-t border-slate-200 px-6 py-4 text-center text-sm text-slate-500\">© 2026 WeHear. All rights reserved.</div></footer><script src=\"/_next/static/chunks/webpack-67c603305a6eb0fa.js\" async=\"\"></script><script>(self.__next_f=self.__next_f||[]).push([0])</script><script>self.__next_f.push([1,\"1:\\\"$Sreact.fragment\\\"\\n2:I[15244,[],\\\"\\\"]\\n3:I[43866,[],\\\"\\\"]\\n4:I[4219,[\\\"7807\\\",\\\"static/chunks/7807-2c8d2f7857c1b84a.js\\\",\\\"2340\\\",\\\"static/chunks/2340-0580248f22a188c2.js\\\",\\\"8173\\\",\\\"static/chunks/8173-ffc9198dd913f23b.js\\\",\\\"5565\\\",\\\"static/chunks/5565-e0050840a0617314.js\\\",\\\"8822\\\",\\\"static/chunks/8822-b1e4e7f90c01938f.js\\\",\\\"1816\\\",\\\"static/chunks/app/(public)/layout-9bfde039de100cc1.js\\\"],\\\"default\\\"]\\n5:I[48173,[\\\"7807\\\",\\\"static/chunks/7807-2c8d2f7857c1b84a.js\\\",\\\"2340\\\",\\\"static/chunks/2340-0580248f22a188c2.js\\\",\\\"8173\\\",\\\"static/chunks/8173-ffc9198dd913f23b.js\\\",\\\"5359\\\",\\\"static/chunks/app/(public)/page-6cdee87d9596850f.js\\\"],\\\"\\\"]\\n6:I[57033,[],\