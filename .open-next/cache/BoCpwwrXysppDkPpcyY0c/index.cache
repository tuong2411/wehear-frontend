{"type":"app","meta":{"headers":{"x-nextjs-stale-time":"4294967294","x-nextjs-prerender":"1","x-next-cache-tags":"_N_T_/layout,_N_T_/(public)/layout,_N_T_/(public)/page,_N_T_/"}},"html":"<!DOCTYPE html><html lang=\"vi\"><head><meta charSet=\"utf-8\"/><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"/><link rel=\"stylesheet\" href=\"/_next/static/css/b635201ed13c643e.css\" data-precedence=\"next\"/><link rel=\"preload\" as=\"script\" fetchPriority=\"low\" href=\"/_next/static/chunks/webpack-67c603305a6eb0fa.js\"/><script src=\"/_next/static/chunks/4bd1b696-9f27df01d2a7123e.js\" async=\"\"></script><script src=\"/_next/static/chunks/1517-528b1b53602be87a.js\" async=\"\"></script><script src=\"/_next/static/chunks/main-app-d7550c1c7c96e9ec.js\" async=\"\"></script><script src=\"/_next/static/chunks/7807-2c8d2f7857c1b84a.js\" async=\"\"></script><script src=\"/_next/static/chunks/2340-0580248f22a188c2.js\" async=\"\"></script><script src=\"/_next/static/chunks/8173-ffc9198dd913f23b.js\" async=\"\"></script><script src=\"/_next/static/chunks/5565-e0050840a0617314.js\" async=\"\"></script><script src=\"/_next/static/chunks/8822-b1e4e7f90c01938f.js\" async=\"\"></script><script src=\"/_next/static/chunks/app/(public)/layout-9bfde039de100cc1.js\" async=\"\"></script><script src=\"/_next/static/chunks/app/(public)/page-6cdee87d9596850f.js\" async=\"\"></script><title>WeHear</title><meta name=\"description\" content=\"Nền tảng dịch ngôn ngữ ký hiệu tiếng Việt bằng AI\"/><link rel=\"icon\" href=\"/favicon.ico\" type=\"image/x-icon\" sizes=\"16x16\"/><script src=\"/_next/static/chunks/polyfills-42372ed130431b0a.js\" noModule=\"\"></script></head><body class=\"__className_f367f3\"><header class=\"sticky top-0 z-50 border-b border-slate-200 bg-white/90 backdrop-blur\"><div class=\"mx-auto flex max-w-7xl items-center justify-between px-6 py-4\"><a class=\"flex items-center gap-2\" href=\"/\"><div class=\"flex h-10 w-10 items-center justify-center rounded-xl bg-blue-600 text-white font-bold shadow-lg shadow-blue-200\">W</div><div><p class=\"text-lg font-bold text-slate-900 leading-tight\">WeHear</p><p class=\"text-[10px] uppercase tracking-wider font-bold text-slate-400\">Vietnamese VSL</p></div></a><nav class=\"hidden items-center gap-8 md:flex\"><a class=\"text-sm font-semibold text-slate-600 transition-colors hover:text-blue-600\" href=\"/\">Trang chủ</a><a class=\"text-sm font-semibold text-slate-600 transition-colors hover:text-blue-600\" href=\"/translate\">Dịch ký hiệu</a><a class=\"text-sm font-semibold text-slate-600 transition-colors hover:text-blue-600\" href=\"/dictionary\">Từ điển</a><a class=\"text-sm font-semibold text-slate-600 transition-colors hover:text-blue-600\" href=\"/lessons\">Bài học</a><a class=\"text-sm font-semibold text-slate-600 transition-colors hover:text-blue-600\" href=\"/community\">Cộng đồng</a><a class=\"text-sm font-semibold text-slate-600 transition-colors hover:text-blue-600\" href=\"/news\">Tin tức</a></nav><div class=\"flex items-center gap-3\"><div class=\"hidden items-center gap-3 sm:flex\"><a class=\"rounded-xl px-4 py-2 text-sm font-bold text-slate-600 transition hover:text-blue-600\" href=\"/login\">Đăng nhập</a><a class=\"rounded-xl bg-blue-600 px-5 py-2.5 text-sm font-bold text-white shadow-lg shadow-blue-200 transition hover:bg-blue-700 active:scale-95\" href=\"/register\">Đăng ký</a></div><button class=\"rounded-lg p-2 text-slate-600 md:hidden\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-menu\" aria-hidden=\"true\"><path d=\"M4 5h16\"></path><path d=\"M4 12h16\"></path><path d=\"M4 19h16\"></path></svg></button></div></div></header><main class=\"min-h-screen\"><main class=\"min-h-screen bg-slate-50\"><section class=\"relative overflow-hidden bg-white pt-16 pb-24 lg:pt-32 lg:pb-40\"><div class=\"absolute top-0 left-1/2 -z-10 h-[600px] w-full -translate-x-1/2 opacity-20 blur-3xl [background:radial-gradient(50%_50%_at_50%_50%,#3b82f6_0%,rgba(255,255,255,0)_100%)]\"></div><div class=\"mx-auto max-w-7xl px-6\"><div class=\"grid gap-16 lg:grid-cols-2 lg:items-center\"><div style=\"opacity:0;transform:translateX(-20px)\"><div class=\"inline-flex items-center gap-2 rounded-full bg-blue-50 px-4 py-2 text-sm font-bold text-blue-600 ring-1 ring-blue-100\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-sparkles h-4 w-4\" aria-hidden=\"true\"><path d=\"M11.017 2.814a1 1 0 0 1 1.966 0l1.051 5.558a2 2 0 0 0 1.594 1.594l5.558 1.051a1 1 0 0 1 0 1.966l-5.558 1.051a2 2 0 0 0-1.594 1.594l-1.051 5.558a1 1 0 0 1-1.966 0l-1.051-5.558a2 2 0 0 0-1.594-1.594l-5.558-1.051a1 1 0 0 1 0-1.966l5.558-1.051a2 2 0 0 0 1.594-1.594z\"></path><path d=\"M20 2v4\"></path><path d=\"M22 4h-4\"></path><circle cx=\"4\" cy=\"20\" r=\"2\"></circle></svg><span>AI nhận diện ngôn ngữ ký hiệu VSL</span></div><h1 class=\"mt-8 text-5xl font-extrabold tracking-tight text-slate-900 md:text-6xl lg:text-7xl\">Lắng nghe bằng <br/><span class=\"bg-gradient-to-r from-blue-600 to-cyan-500 bg-clip-text text-transparent\">Đôi bàn tay</span></h1><p class=\"mt-8 text-xl leading-relaxed text-slate-600 md:max-w-xl\">WeHear xóa bỏ rào cản giao tiếp cho cộng đồng người khiếm thính Việt Nam bằng công nghệ AI dịch thuật thời gian thực và hệ sinh thái học tập toàn diện.</p><div class=\"mt-10 flex flex-wrap gap-4\"><a class=\"group flex items-center gap-2 rounded-2xl bg-blue-600 px-8 py-4 text-lg font-bold text-white shadow-xl shadow-blue-200 transition-all hover:bg-blue-700 hover:shadow-2xl active:scale-95\" href=\"/translate\">Trải nghiệm ngay<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-right h-5 w-5 transition-transform group-hover:translate-x-1\" aria-hidden=\"true\"><path d=\"M5 12h14\"></path><path d=\"m12 5 7 7-7 7\"></path></svg></a><a class=\"flex items-center gap-2 rounded-2xl bg-white px-8 py-4 text-lg font-bold text-slate-700 shadow-sm ring-1 ring-slate-200 transition-all hover:bg-slate-50 active:scale-95\" href=\"/dictionary\">Tra cứu từ điển</a></div><div class=\"mt-10 flex items-center gap-6 text-sm text-slate-400\"><div class=\"flex -space-x-3\"><div class=\"h-10 w-10 rounded-full border-2 border-white bg-slate-200 shadow-sm\"></div><div class=\"h-10 w-10 rounded-full border-2 border-white bg-slate-200 shadow-sm\"></div><div class=\"h-10 w-10 rounded-full border-2 border-white bg-slate-200 shadow-sm\"></div><div class=\"h-10 w-10 rounded-full border-2 border-white bg-slate-200 shadow-sm\"></div></div><p><span class=\"font-bold text-slate-900\">+500</span> người đã tham gia cộng đồng</p></div></div><div class=\"relative\" style=\"opacity:0;transform:scale(0.9)\"><div class=\"relative z-10 overflow-hidden rounded-[40px] bg-slate-900 p-4 shadow-2xl ring-1 ring-slate-800\"><div class=\"aspect-video w-full rounded-[32px] bg-slate-800 flex items-center justify-center overflow-hidden group cursor-pointer\"><div class=\"h-20 w-20 rounded-full bg-blue-600/90 flex items-center justify-center text-white transition-transform group-hover:scale-110\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-play h-8 w-8 fill-current ml-1\" aria-hidden=\"true\"><path d=\"M5 5a2 2 0 0 1 3.008-1.728l11.997 6.998a2 2 0 0 1 .003 3.458l-12 7A2 2 0 0 1 5 19z\"></path></svg></div><div class=\"absolute inset-0 p-8 flex flex-col justify-end\"><div class=\"flex justify-end items-end\"><div class=\"h-24 w-1 bg-blue-500 rounded-full animate-pulse shadow-[0_0_15px_rgba(59,130,246,0.5)]\"></div></div></div></div></div><div class=\"absolute -top-6 -right-6 h-24 w-24 rounded-3xl bg-blue-100/50 -z-10 blur-xl\"></div><div class=\"absolute -bottom-10 -left-10 h-32 w-32 rounded-full bg-cyan-100/50 -z-10 blur-2xl\"></div></div></div></div></section><section class=\"py-16\"><div class=\"mx-auto max-w-7xl px-6\"><div class=\"grid gap-6 rounded-[32px] bg-white p-8 shadow-sm md:grid-cols-2\"><div><p class=\"text-sm font-semibold uppercase tracking-wide text-blue-600\">Dịch nhanh</p><h2 class=\"mt-3 text-3xl font-bold text-slate-900\">Bắt đầu sử dụng AI để dịch ký hiệu ngay trên trình duyệt</h2><p class=\"mt-4 text-slate-600\">Người dùng có thể bật camera để nhận diện trực tiếp hoặc tải video lên để hệ thống phân tích và chuyển đổi sang văn bản tiếng Việt.</p><div class=\"mt-6 flex flex-wrap gap-4\"><a class=\"rounded-2xl bg-blue-600 px-5 py-3 font-medium text-white transition hover:bg-blue-700\" href=\"/translate\">Mở camera</a><a class=\"rounded-2xl border border-slate-300 px-5 py-3 font-medium text-slate-700 transition hover:bg-slate-100\" href=\"/translate\">Tải video</a></div></div><div class=\"grid gap-4\"><div class=\"rounded-2xl bg-slate-50 p-5\"><h3 class=\"font-semibold text-slate-900\">Dịch trực tiếp qua camera</h3><p class=\"mt-2 text-sm text-slate-600\">Nhận diện ký hiệu theo thời gian thực và hiển thị phụ đề ngay lập tức.</p></div><div class=\"rounded-2xl bg-slate-50 p-5\"><h3 class=\"font-semibold text-slate-900\">Dịch từ video tải lên</h3><p class=\"mt-2 text-sm text-slate-600\">Phân tích video ký hiệu đã quay sẵn để kiểm tra nội dung và kết quả dịch.</p></div></div></div></div></section><section class=\"py-24 bg-white\"><div class=\"mx-auto max-w-7xl px-6\"><div class=\"mx-auto mb-16 max-w-3xl text-center\"><h2 class=\"text-4xl font-extrabold tracking-tight text-slate-900 md:text-5xl\">Vì một cộng đồng <span class=\"text-blue-600\">không rào cản</span></h2><p class=\"mt-6 text-xl text-slate-500 leading-relaxed\">WeHear mang đến bộ công cụ toàn diện hỗ trợ người khiếm thính và người muốn tìm hiểu ngôn ngữ ký hiệu.</p></div><div class=\"grid gap-8 md:grid-cols-2 lg:grid-cols-4\"><div class=\"group relative overflow-hidden rounded-[32px] border border-blue-100 bg-blue-50/50 p-8 transition-all hover:shadow-2xl hover:shadow-blue-100\" style=\"opacity:0;transform:translateY(20px)\"><div class=\"flex h-16 w-16 items-center justify-center rounded-2xl bg-white shadow-sm ring-1 ring-slate-100 transition-transform group-hover:scale-110 group-hover:rotate-3\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-hand h-8 w-8 text-blue-600\" aria-hidden=\"true\"><path d=\"M18 11V6a2 2 0 0 0-2-2a2 2 0 0 0-2 2\"></path><path d=\"M14 10V4a2 2 0 0 0-2-2a2 2 0 0 0-2 2v2\"></path><path d=\"M10 10.5V6a2 2 0 0 0-2-2a2 2 0 0 0-2 2v8\"></path><path d=\"M18 8a2 2 0 1 1 4 0v6a8 8 0 0 1-8 8h-2c-2.8 0-4.5-.86-5.99-2.34l-3.6-3.6a2 2 0 0 1 2.83-2.82L7 15\"></path></svg></div><h3 class=\"mt-8 text-xl font-bold text-slate-900\">Nhận diện ký hiệu bằng AI</h3><p class=\"mt-4 text-base leading-relaxed text-slate-600\">Công nghệ Deep Learning nhận diện cử động tay và dịch sang văn bản chính xác.</p><div class=\"absolute -bottom-10 -right-10 h-32 w-32 rounded-full bg-white opacity-50 blur-3xl transition-transform group-hover:scale-150\"></div></div><div class=\"group relative overflow-hidden rounded-[32px] border border-cyan-100 bg-cyan-50/50 p-8 transition-all hover:shadow-2xl hover:shadow-blue-100\" style=\"opacity:0;transform:translateY(20px)\"><div class=\"flex h-16 w-16 items-center justify-center rounded-2xl bg-white shadow-sm ring-1 ring-slate-100 transition-transform group-hover:scale-110 group-hover:rotate-3\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-book-open h-8 w-8 text-cyan-600\" aria-hidden=\"true\"><path d=\"M12 7v14\"></path><path d=\"M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z\"></path></svg></div><h3 class=\"mt-8 text-xl font-bold text-slate-900\">Từ điển ký hiệu VSL</h3><p class=\"mt-4 text-base leading-relaxed text-slate-600\">Tra cứu hàng nghìn từ vựng ký hiệu với video hướng dẫn chi tiết.</p><div class=\"absolute -bottom-10 -right-10 h-32 w-32 rounded-full bg-white opacity-50 blur-3xl transition-transform group-hover:scale-150\"></div></div><div class=\"group relative overflow-hidden rounded-[32px] border border-violet-100 bg-violet-50/50 p-8 transition-all hover:shadow-2xl hover:shadow-blue-100\" style=\"opacity:0;transform:translateY(20px)\"><div class=\"flex h-16 w-16 items-center justify-center rounded-2xl bg-white shadow-sm ring-1 ring-slate-100 transition-transform group-hover:scale-110 group-hover:rotate-3\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-sparkles h-8 w-8 text-violet-600\" aria-hidden=\"true\"><path d=\"M11.017 2.814a1 1 0 0 1 1.966 0l1.051 5.558a2 2 0 0 0 1.594 1.594l5.558 1.051a1 1 0 0 1 0 1.966l-5.558 1.051a2 2 0 0 0-1.594 1.594l-1.051 5.558a1 1 0 0 1-1.966 0l-1.051-5.558a2 2 0 0 0-1.594-1.594l-5.558-1.051a1 1 0 0 1 0-1.966l5.558-1.051a2 2 0 0 0 1.594-1.594z\"></path><path d=\"M20 2v4\"></path><path d=\"M22 4h-4\"></path><circle cx=\"4\" cy=\"20\" r=\"2\"></circle></svg></div><h3 class=\"mt-8 text-xl font-bold text-slate-900\">Học tập &amp; Trắc nghiệm</h3><p class=\"mt-4 text-base leading-relaxed text-slate-600\">Hệ thống bài học theo chủ đề và các bài test để kiểm tra kiến thức của bạn.</p><div class=\"absolute -bottom-10 -right-10 h-32 w-32 rounded-full bg-white opacity-50 blur-3xl transition-transform group-hover:scale-150\"></div></div><div class=\"group relative overflow-hidden rounded-[32px] border border-emerald-100 bg-emerald-50/50 p-8 transition-all hover:shadow-2xl hover:shadow-blue-100\" style=\"opacity:0;transform:translateY(20px)\"><div class=\"flex h-16 w-16 items-center justify-center rounded-2xl bg-white shadow-sm ring-1 ring-slate-100 transition-transform group-hover:scale-110 group-hover:rotate-3\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-newspaper h-8 w-8 text-emerald-600\" aria-hidden=\"true\"><path d=\"M15 18h-5\"></path><path d=\"M18 14h-8\"></path><path d=\"M4 22h16a2 2 0 0 0 2-2V4a2 2 0 0 0-2-2H8a2 2 0 0 0-2 2v16a2 2 0 0 1-4 0v-9a2 2 0 0 1 2-2h2\"></path><rect width=\"8\" height=\"4\" x=\"10\" y=\"6\" rx=\"1\"></rect></svg></div><h3 class=\"mt-8 text-xl font-bold text-slate-900\">Tin tức Chuyên biệt</h3><p class=\"mt-4 text-base leading-relaxed text-slate-600\">Tổng hợp tin tức quốc tế và trong nước về cộng đồng khiếm thính.</p><div class=\"absolute -bottom-10 -right-10 h-32 w-32 rounded-full bg-white opacity-50 blur-3xl transition-transform group-hover:scale-150\"></div></div></div></div></section><section class=\"py-24 bg-slate-50\"><div class=\"mx-auto max-w-7xl px-6\"><div class=\"mb-12 flex flex-col md:flex-row md:items-end justify-between gap-6\"><div class=\"max-w-2xl\"><div class=\"inline-flex items-center gap-2 rounded-full bg-blue-100 px-3 py-1 text-xs font-bold text-blue-600\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-newspaper h-3 w-3\" aria-hidden=\"true\"><path d=\"M15 18h-5\"></path><path d=\"M18 14h-8\"></path><path d=\"M4 22h16a2 2 0 0 0 2-2V4a2 2 0 0 0-2-2H8a2 2 0 0 0-2 2v16a2 2 0 0 1-4 0v-9a2 2 0 0 1 2-2h2\"></path><rect width=\"8\" height=\"4\" x=\"10\" y=\"6\" rx=\"1\"></rect></svg><span>TIN TỨC CẬP NHẬT</span></div><h2 class=\"mt-4 text-4xl font-bold text-slate-900 tracking-tight\">Cập nhật mới nhất từ <br/> cộng đồng người khiếm thính</h2><p class=\"mt-4 text-lg text-slate-500\">Những thông tin mới nhất về công nghệ hỗ trợ, giáo dục và các hoạt động cộng đồng nổi bật.</p></div><a class=\"group flex items-center gap-2 font-bold text-blue-600 transition-colors hover:text-blue-700\" href=\"/news\">Xem tất cả bài viết<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-right h-5 w-5 transition-transform group-hover:translate-x-1\" aria-hidden=\"true\"><path d=\"M5 12h14\"></path><path d=\"m12 5 7 7-7 7\"></path></svg></a></div><div class=\"grid gap-8 md:grid-cols-3\"><div class=\"h-96 animate-pulse rounded-[24px] bg-slate-200\"></div><div class=\"h-96 animate-pulse rounded-[24px] bg-slate-200\"></div><div class=\"h-96 animate-pulse rounded-[24px] bg-slate-200\"></div></div></div></section><section class=\"pb-20 pt-16\"><div class=\"mx-auto max-w-7xl px-6\"><div class=\"mx-auto mb-10 max-w-2xl text-center\"><p class=\"text-sm font-semibold uppercase tracking-wide text-blue-600\">Học tập</p><h2 class=\"mt-2 text-3xl font-bold text-slate-900\">Học ngôn ngữ ký hiệu theo lộ trình dễ tiếp cận</h2><p class=\"mt-3 text-slate-600\">Hệ thống cung cấp các bài học từ cơ bản đến nâng cao, kết hợp với quiz để người dùng luyện tập thường xuyên.</p></div><div class=\"grid gap-6 md:grid-cols-3\"><div class=\"rounded-[28px] bg-white p-6 shadow-sm transition hover:-translate-y-1 hover:shadow-md\"><span class=\"inline-block rounded-full bg-blue-50 px-3 py-1 text-xs font-semibold text-blue-600\">Cơ bản</span><h3 class=\"mt-4 text-xl font-bold text-slate-900\">Giao tiếp cơ bản</h3><p class=\"mt-3 text-sm leading-6 text-slate-600\">Làm quen với các ký hiệu chào hỏi và giao tiếp hàng ngày.</p><button class=\"mt-6 rounded-xl bg-slate-900 px-4 py-2 text-sm font-medium text-white transition hover:bg-slate-800\">Khám phá bài học</button></div><div class=\"rounded-[28px] bg-white p-6 shadow-sm transition hover:-translate-y-1 hover:shadow-md\"><span class=\"inline-block rounded-full bg-blue-50 px-3 py-1 text-xs font-semibold text-blue-600\">Trung cấp</span><h3 class=\"mt-4 text-xl font-bold text-slate-900\">Từ vựng hành chính</h3><p class=\"mt-3 text-sm leading-6 text-slate-600\">Các ký hiệu liên quan đến địa chỉ, tỉnh thành và thông tin công việc.</p><button class=\"mt-6 rounded-xl bg-slate-900 px-4 py-2 text-sm font-medium text-white transition hover:bg-slate-800\">Khám phá bài học</button></div><div class=\"rounded-[28px] bg-white p-6 shadow-sm transition hover:-translate-y-1 hover:shadow-md\"><span class=\"inline-block rounded-full bg-blue-50 px-3 py-1 text-xs font-semibold text-blue-600\">Luyện tập</span><h3 class=\"mt-4 text-xl font-bold text-slate-900\">Ôn tập bằng câu hỏi</h3><p class=\"mt-3 text-sm leading-6 text-slate-600\">Kiểm tra khả năng ghi nhớ ký hiệu thông qua bài trắc nghiệm ngắn.</p><button class=\"mt-6 rounded-xl bg-slate-900 px-4 py-2 text-sm font-medium text-white transition hover:bg-slate-800\">Khám phá bài học</button></div></div></div></section></main></main><footer class=\"border-t border-slate-200 bg-white\"><div class=\"mx-auto grid max-w-7xl gap-10 px-6 py-12 md:grid-cols-3\"><div><h3 class=\"text-xl font-bold text-slate-900\">WeHear</h3><p class=\"mt-3 text-sm leading-6 text-slate-600\">Nền tảng hỗ trợ nhận diện và dịch ngôn ngữ ký hiệu tiếng Việt sang văn bản, giúp tăng khả năng giao tiếp và tiếp cận thông tin cho cộng đồng người khiếm thính.</p></div><div><h4 class=\"text-sm 