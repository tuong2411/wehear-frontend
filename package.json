{
  "name": "wehear-frontend",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "next start -p 3001",
    "lint": "eslint",
    "build:cf": "rm -rf .next/cache cache node_modules/.cache && next build && npx @cloudflare/next-on-pages",
    "build:worker": "npx @opennextjs/cloudflare build",
    "deploy": "npm run build:worker && wrangler deploy"
  },
  "dependencies": {
    "axios": "^1.13.6",
    "framer-motion": "^12.35.0",
    "lucide-react": "^0.577.0",
    "next": "15.5.18",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-hot-toast": "^2.6.0",
    "react-webcam": "^7.2.0",
    "socket.io-client": "^4.8.3"
    },
    "devDependencies": {
    "@cloudflare/next-on-pages": "^1.13.16",
    "@cloudflare/workers-types": "^4.20240401.0",
    "@opennextjs/cloudflare": "^1.19.10",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.18",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.86.0"
    }
    }

